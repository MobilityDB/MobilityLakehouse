# Copy to .env and set EXTENSION_PATH. Nothing else needs changing for a
# default local run.
#
# Use a build of MobilityDuck that can construct L2/L3/L4.
MOBILITYDUCK__EXTENSION_PATH=/abs/path/to/mobilityduck.duckdb_extension
MOBILITYDUCK__DB_PATH=./data/ais_mobilityduck.duckdb
MOBILITYDUCK__SCHEMA_NAME=lakehouse
MOBILITYDUCK__ALLOW_UNSIGNED_EXTENSIONS=true
PIPELINE__RAW_DIR=./data/raw
PIPELINE__CLEAN_DIR=./data/clean
PIPELINE__BATCH_SIZE=250000

# Scaling knobs: raise these on a bigger machine, see README > Install.
# PIPELINE__DUCKDB_THREADS=8
# PIPELINE__DUCKDB_MEMORY_LIMIT=48GB
# PIPELINE__DUCKDB_TEMP_DIRECTORY=/scratch/duckdb_spill
# PIPELINE__DUCKDB_MAX_TEMP_DIRECTORY_SIZE=400GB
